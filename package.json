{
  "name": "menu-semaine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application personnelle mobile-first (PWA) pour composer ses menus de la semaine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "seed:staging": "node scripts/seed-staging.mjs",
    "parity:check": "node scripts/parity-check.mjs"
  },
  "dependencies": {
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.108.2",
    "fix-webm-duration": "^1.0.6",
    "idb": "^8.0.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/lz-string": "^1.5.0",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
