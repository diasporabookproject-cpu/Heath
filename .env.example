# Synchro multi-appareils (Supabase). Sans ces variables, l'app fonctionne
# en local uniquement (offline-first), sans connexion ni synchro.
VITE_SUPABASE_URL=
# Clé "Publishable" (sb_publishable_...), publique par design (protégée par RLS).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Sentry (crash-reporting). DSN = clé d'ingestion publique. Vide => Sentry désactivé.
VITE_SENTRY_DSN=
